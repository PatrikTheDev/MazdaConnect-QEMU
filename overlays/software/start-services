#!/bin/sh
# Source this file after starting the compositor; keep D-Bus addresses in the caller.
export LAB_LOG_DIR="${LAB_LOG_DIR:-/tmp/software}"
mkdir -p "$LAB_LOG_DIR" /tmp/var/run/dbus /tmp/var/log /tmp/mnt/data /tmp/mnt/data_persist
if [ "${LAB_INTRO_RACE_FIX:-0}" = 1 ]; then
    cp /lab-software/libjciuiasystem-intro-fix.so /jci/mmui/uia/libjciuiasystem.so || return 1
    cp /lab-software/intro-race-fix.json "$LAB_LOG_DIR/intro-race-fix.json" || return 1
    echo 'LAB_INTRO_RACE_FIX enabled: original disclaimer event after completed intro in Normal state'
fi
if [ "${LAB_TIME_DEADLINE_FIX:-0}" = 1 ]; then
    cp /lab-software/svcjciblmtime-deadline-fix.so /jci/time/svcjciblmtime.so || return 1
    cp /lab-software/time-deadline-fix.json "$LAB_LOG_DIR/time-deadline-fix.json" || return 1
    export LAB_TIME_SERVICES=1
    echo 'LAB_TIME_DEADLINE_FIX enabled: CLOCK_REALTIME deadline for stock sem_timedwait'
fi
if [ "${LAB_WEBSOCKETS_QUEUE_FIX:-0}" = 1 ]; then
    cp /lab-software/Websockets-queue-fix.js /jci/gui/framework/js/Websockets.js || return 1
    cp /lab-software/websockets-queue-fix.json "$LAB_LOG_DIR/websockets-queue-fix.json" || return 1
    echo 'LAB_WEBSOCKETS_QUEUE_FIX enabled: documented original GUI queue correction'
fi
mount -t ext4 -o ro,noload "$(/bin/busybox findfs LABEL=MAZDA_MESA)" /lab-software/runtime || return 1
cp /jci/integration/config-mfg-bak/passwd /config-mfg/passwd
chown cmu /tmp/mnt/data /tmp/mnt/data_persist
/bin/busybox ifconfig lo up
/bin/busybox syslogd -s 0 -O "$LAB_LOG_DIR/syslog.log"
/usr/bin/dbus start
# shellcheck disable=SC1091
. /tmp/dbus.env
if [ "${LAB_VENDOR_LVDS_PROBE:-0}" != 1 ]; then
    /lab-software/runtime/ld-linux.so.3 --library-path /lab-software/runtime /lab-software/display-service > "$LAB_LOG_DIR/display.log" 2>&1 &
fi
ln -s event2 /dev/input/keyboard0
[ -e /dev/input/mouse0 ] || ln -s event1 /dev/input/mouse0
ln -s event1 /dev/input/touchscreen
if [ "${LAB_VIP_SERVICE:-0}" = 1 ]; then
    /lab-software/vip-service --tau-state "${LAB_TAU_STATE:-connected}" > "$LAB_LOG_DIR/vip-service.log" 2>&1 &
    lab_vip_pid=$!
    /jci/vim/vim_app > "$LAB_LOG_DIR/vim.log" 2>&1 &
    lab_vim_pid=$!
    lab_vip_wait=0
    while ! /bin/busybox grep -q '^VIP_HELLO_ACKED$' "$LAB_LOG_DIR/vip-service.log"; do
        if ! kill -0 "$lab_vip_pid" || ! kill -0 "$lab_vim_pid" || [ "$lab_vip_wait" -ge 10 ]; then
            echo 'Original VIM/VIP handshake did not complete before service startup' >&2
            return 1
        fi
        sleep 1
        lab_vip_wait=$((lab_vip_wait + 1))
    done
fi
/jci/nativegui/svcjcinativeguictrl > "$LAB_LOG_DIR/nativegui.log" 2>&1 &
lab_sm_config=/lab-software/sm.conf
if [ "${LAB_AUDIO_SERVICES:-0}" = 1 ]; then
    /lab-software/configure-audio > "$LAB_LOG_DIR/audio-config.log" 2>&1 || return 1
    lab_sm_config=/lab-software/sm-audio.conf
fi
if [ "${LAB_TIME_SERVICES:-0}" = 1 ]; then
    lab_sm_config="${lab_sm_config%.conf}-time.conf"
fi
/jci/sm/sm -f "$lab_sm_config" -e "$LAB_LOG_DIR/smevents.txt" > "$LAB_LOG_DIR/sm.log" 2>&1 &
